# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Ignore Jupyter checkpoints
.ipynb_checkpoints/

# Ignore the spreadsheets the markdown_generator TSVs are exported from
*.numbers

# Ignore the generated search dump
search.txt

# Ignore the source PDFs of research figures; only the converted
# SVG/PNG/GIF that the site actually loads is committed
images/research/*.pdf
